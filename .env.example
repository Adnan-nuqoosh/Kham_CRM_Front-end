# KHAM Commerce API — storefront uses /api/v1/storefront/*
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Production:
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# Default market (used before shopper picks another in the header)
NEXT_PUBLIC_STORE_MARKET=EG
NEXT_PUBLIC_STORE_MARKET_ID=1
# Required for multi-market prices: code → numeric market_id (must match DB)
NEXT_PUBLIC_STORE_MARKET_IDS=EG:1,AE:2,SA:3
NEXT_PUBLIC_STORE_LOCALE=en

# Local-only: call POST /storefront/checkout/test-order (backend must also enable it)
# NEXT_PUBLIC_STOREFRONT_TEST_CHECKOUT=true
